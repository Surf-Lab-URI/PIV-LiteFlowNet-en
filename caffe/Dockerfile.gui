# Use GCC-11 libstdc++ for MATLAB
#ENV LD_PRELOAD=/usr/lib/gcc/x86_64-linux-gnu/11/libstdc++.so

# === Set environment ===
ENV LANG C.UTF-8
ENV MATLAB_DISABLE_SANDBOX=1
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y xfonts-base xfonts-75dpi xfonts-100dpi
RUN apt-get install -y xfonts-utils
# === Create user ===
RUN useradd -ms /bin/bash surflab && echo "surflab ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers
USER surflab
WORKDIR /home/surflab

# === Set up VNC ===
RUN mkdir -p /home/surflab/.vnc
USER root
COPY xstartup /home/surflab/.vnc/xstartup
RUN chown surflab:surflab /home/surflab/.vnc/xstartup && chmod +x /home/surflab/.vnc/xstartup

USER root

RUN apt-get update && apt-get install -y iputils-ping curl

ENV USER=surflab

# === Set VNC password (default: 'vncpass') ===
#RUN echo "vncpass\nvncpass\nn" | vncpasswd

# === Expose VNC port ===
#EXPOSE 5901

# === Entry point ===
#CMD vncserver :1 -geometry 1280x800 -depth 24 && tail -F /home/surflab/.vnc/*.log

USER surflab
# Default command
#CMD ["/bin/bash"]

