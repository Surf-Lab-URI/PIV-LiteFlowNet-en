# Base image with CUDA 8.0 and Ubuntu 14.04 with cudnn5
FROM perfectweb/base:cuda-8.0-devel-ubuntu16.04-v1 AS base

# === System setup ===
ENV DEBIAN_FRONTEND=noninteractive

RUN rm /etc/apt/sources.list.d/cuda*.list || true

RUN apt-get update

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-4.8 g++-4.8 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
    
# === Set GCC 4.8 as default ===
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-4.8 100 \
 && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-4.8 100
ENV CC=gcc-4.8
ENV CXX=g++-4.8

RUN apt-get update && apt-get install -y --no-install-recommends \
    apt-transport-https \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    apt-utils \
    build-essential \
    cmake git wget curl unzip sudo \
    nano \
    libboost-all-dev \
    libprotobuf-dev protobuf-compiler \
    libgflags-dev libgoogle-glog-dev liblmdb-dev \
    libhdf5-dev libopencv-dev \
    python2 python2-pip \
    libatlas-base-dev \
    libopenblas-dev \
    liblapack-dev \
    libleveldb-dev\
    libsnappy-dev\
    libxrender1 libxtst6 libxi6 libxrandr2 libgtk2.0-0 \
    libgl1-mesa-glx libglu1-mesa mesa-utils x11-apps \
    xfce4 xfce4-goodies tightvncserver dbus-x11 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
 
# cuDNN installation (copy .deb files into the build context and ADD them)
WORKDIR /tmp
COPY cudnn-8.0-linux-x64-v5.1.tgz /tmp/cudnn-8.0-linux-x64-v5.1.tgz
RUN tar -xzvf cudnn-8.0-linux-x64-v5.1.tgz
RUN cp -P cuda/include/cudnn*.h /usr/local/cuda/include
RUN cp -P cuda/lib64/libcudnn* /usr/local/cuda/lib64
RUN chmod a+r /usr/local/cuda/include/cudnn*.h /usr/local/cuda/lib64/libcudnn*
#ADD libcudnn7-dev_7.6.5.32-1+cuda10.2_amd64.deb /tmp/
#RUN dpkg -i /tmp/libcudnn7_7.6.5.32-1+cuda10.2_amd64.deb && \
#    dpkg -i /tmp/libcudnn7-dev_7.6.5.32-1+cuda10.2_amd64.deb && \
#    rm -rf /tmp/*.deb


