#The first time you start it, you will want to mount a directory with the MATLAB R2017b installer in it, using something like this:
#sudo docker run -it -gpus all   -e DISPLAY=$DISPLAY   -v /tmp/.X11-unix:/tmp/.X11-unix   -v /Path/to/installer/directory:/home/surflab/matlab_R2017b_glnxa64   caffe-matlab-gcc8


# Base image with CUDA 10.2 and Ubuntu 18.04
FROM perfectweb/base:cuda-10.2-devel-ubuntu18.04 AS base

# === System setup ===
ENV DEBIAN_FRONTEND=noninteractive

RUN rm /etc/apt/sources.list.d/cuda*.list || true

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc-8 g++-8 \
    cmake git wget curl unzip sudo \
    libboost-all-dev \
    libprotobuf-dev protobuf-compiler \
    libgflags-dev libgoogle-glog-dev liblmdb-dev \
    libhdf5-dev libopencv-dev \
    python3 python3-pip \
    libatlas-base-dev \
    libopenblas-dev \
    liblapack-dev \
    libleveldb-dev\
    libsnappy-dev\
    libxrender1 libxtst6 libxi6 libxrandr2 libgtk2.0-0 \
    libgl1-mesa-glx libglu1-mesa mesa-utils x11-apps \
    xfce4 xfce4-goodies tightvncserver dbus-x11 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# === Set GCC 8 as default ===
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-8 100 \
 && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-8 100
 
# cuDNN installation (copy .deb files into the build context and ADD them)
ADD libcudnn7_7.6.5.32-1+cuda10.2_amd64.deb /tmp/
ADD libcudnn7-dev_7.6.5.32-1+cuda10.2_amd64.deb /tmp/
RUN dpkg -i /tmp/libcudnn7_7.6.5.32-1+cuda10.2_amd64.deb && \
    dpkg -i /tmp/libcudnn7-dev_7.6.5.32-1+cuda10.2_amd64.deb && \
    rm -rf /tmp/*.deb


# Clone Caffe with submodules (for full source including examples/)
WORKDIR /opt
ARG CACHEBUST=1
RUN echo "cache bust = $CACHEBUST" && \
	git clone https://github.com/Surf-Lab-URI/PIV-LiteFlowNet-en.git

# Set environment variables
ENV CAFFE_ROOT=/opt/PIV-LiteFlowNet-en/caffe
WORKDIR $CAFFE_ROOT


# Build Caffe (CPU and GPU support, no MATLAB for now)
RUN make clean
ENV CC=gcc-8
ENV CXX=g++-8
RUN make all -j"$(nproc)" || true  # allow fail for non-MATLAB parts

# Add toolchain test builds PPA and install gcc-11
#RUN apt-get update && \
#   apt-get install -y software-properties-common && \
#   add-apt-repository -y ppa:ubuntu-toolchain-r/test && \
#   apt-get update && \
#   apt-get install -y gcc-11 g++-11
    
# Use GCC-11 libstdc++ for MATLAB
#ENV LD_PRELOAD=/usr/lib/gcc/x86_64-linux-gnu/11/libstdc++.so

# === Set environment ===
ENV LANG C.UTF-8
ENV MATLAB_DISABLE_SANDBOX=1
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y xfonts-base xfonts-75dpi xfonts-100dpi
RUN apt-get install -y xfonts-utils
# === Create user ===
RUN useradd -ms /bin/bash surflab && echo "surflab ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers
USER surflab
WORKDIR /home/surflab

# === Set up VNC ===
RUN mkdir -p /home/surflab/.vnc
USER root
COPY xstartup /home/surflab/.vnc/xstartup
RUN chown surflab:surflab /home/surflab/.vnc/xstartup && chmod +x /home/surflab/.vnc/xstartup

USER root

RUN apt-get update && apt-get install -y iputils-ping curl

ENV USER=surflab

# === Set VNC password (default: 'vncpass') ===
#RUN echo "vncpass\nvncpass\nn" | vncpasswd

# === Expose VNC port ===
#EXPOSE 5901

# === Entry point ===
#CMD vncserver :1 -geometry 1280x800 -depth 24 && tail -F /home/surflab/.vnc/*.log

USER surflab
# Default command
#CMD ["/bin/bash"]

